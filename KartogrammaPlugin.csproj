<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ═══════════════════════════════════════════════════════════════
     СОВМЕСТИМОСТЬ:
       Civil 3D 2015-2024  →  .NET Framework 4.8  (net48)
       Civil 3D 2025+      →  .NET 8              (net8.0-windows)

     Сборка ОБА варианта.
     Проект автоматически находит DLL из той версии AutoCAD,
     которая установлена на данном ПК (2015–2026).

     Civil 3D 2011-2014 НЕ поддерживается: другая структура API,
     отсутствие accoremgd.dll (до 2013), .NET 3.5/4.0.
    ═══════════════════════════════════════════════════════════════
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyName>openkartogramma</AssemblyName>
    <RootNamespace>KartogrammaPlugin</RootNamespace>
    <Version>1.1.2</Version>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <!-- AutoCAD DLL не копируем в output — они уже есть в папке AutoCAD -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Исключаем тестовый проект из основной сборки -->
  <ItemGroup>
    <Compile Remove="KartogrammaTests\**" />
    <None Remove="KartogrammaTests\**" />
  </ItemGroup>

  <!--
    Пакет reference-сборок .NET Framework гарантирует компиляцию
    net45/net48 даже без установленных targeting pack (Visual Studio).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    ═══════════════════════════════════════════════════════════════
     ПУТИ К DLL — автоопределение установленной версии AutoCAD,
     ОТДЕЛЬНО для каждой линейки (перебор годов, как раньше):
       net48          ← Civil 3D 2015-2024 (DLL под .NET Framework)
       net8.0-windows ← Civil 3D 2025-2026 (DLL под .NET 8)
     Смешивать линейки нельзя: net48 против DLL 2025+ даёт CS1705.
     Год засчитывается, только если есть и AutoCAD (acdbmgd), и
     Civil 3D (AeccDbMgd) — обычный AutoCAD без Civil не подходит.

     Если своей линейки на ПК нет — фолбэк на референсные DLL из
     libs\acad-refs (лежат в проекте, интернет НЕ нужен). Поэтому
     сборка на ЛЮБОЙ машине всегда даёт обе DLL, и установщик всегда
     поддерживает Civil 3D 2015-2024 и 2025+ одновременно. Версия
     референсных DLL не ограничивает совместимость: сборки AutoCAD не
     strong-named, .NET биндит их по имени, без проверки версии.
    ═══════════════════════════════════════════════════════════════
  -->
  <PropertyGroup>
    <AcadPath2026>C:\Program Files\Autodesk\AutoCAD 2026</AcadPath2026>
    <AcadPath2025>C:\Program Files\Autodesk\AutoCAD 2025</AcadPath2025>
    <AcadPath2024>C:\Program Files\Autodesk\AutoCAD 2024</AcadPath2024>
    <AcadPath2023>C:\Program Files\Autodesk\AutoCAD 2023</AcadPath2023>
    <AcadPath2022>C:\Program Files\Autodesk\AutoCAD 2022</AcadPath2022>
    <AcadPath2021>C:\Program Files\Autodesk\AutoCAD 2021</AcadPath2021>
    <AcadPath2020>C:\Program Files\Autodesk\AutoCAD 2020</AcadPath2020>
    <AcadPath2019>C:\Program Files\Autodesk\AutoCAD 2019</AcadPath2019>
    <AcadPath2018>C:\Program Files\Autodesk\AutoCAD 2018</AcadPath2018>
    <AcadPath2017>C:\Program Files\Autodesk\AutoCAD 2017</AcadPath2017>
    <AcadPath2016>C:\Program Files\Autodesk\AutoCAD 2016</AcadPath2016>
    <AcadPath2015>C:\Program Files\Autodesk\AutoCAD 2015</AcadPath2015>

    <!-- Линейка .NET 8 (2026 → 2025): AutoCAD + Civil 3D обязательны -->
    <AcadPathNet8 Condition="'$(AcadPathNet8)' == '' AND Exists('$(AcadPath2026)\acdbmgd.dll') AND (Exists('$(AcadPath2026)\C3D\AeccDbMgd.dll') OR Exists('$(AcadPath2026)\AeccDbMgd.dll'))">$(AcadPath2026)</AcadPathNet8>
    <AcadPathNet8 Condition="'$(AcadPathNet8)' == '' AND Exists('$(AcadPath2025)\acdbmgd.dll') AND (Exists('$(AcadPath2025)\C3D\AeccDbMgd.dll') OR Exists('$(AcadPath2025)\AeccDbMgd.dll'))">$(AcadPath2025)</AcadPathNet8>
    <!-- Нет установленного Civil 3D 2025+ → референсные DLL из проекта -->
    <AcadPathNet8 Condition="'$(AcadPathNet8)' == '' AND Exists('$(MSBuildProjectDirectory)\libs\acad-refs\net8\acdbmgd.dll')">$(MSBuildProjectDirectory)\libs\acad-refs\net8</AcadPathNet8>

    <!-- Линейка .NET Framework (2024 → … → 2015): AutoCAD + Civil 3D обязательны -->
    <AcadPathNetFx Condition="'$(AcadPathNetFx)' == '' AND Exists('$(AcadPath2024)\acdbmgd.dll') AND (Exists('$(AcadPath2024)\C3D\AeccDbMgd.dll') OR Exists('$(AcadPath2024)\AeccDbMgd.dll'))">$(AcadPath2024)</AcadPathNetFx>
    <AcadPathNetFx Condition="'$(AcadPathNetFx)' == '' AND Exists('$(AcadPath2023)\acdbmgd.dll') AND (Exists('$(AcadPath2023)\C3D\AeccDbMgd.dll') OR Exists('$(AcadPath2023)\AeccDbMgd.dll'))">$(AcadPath2023)</AcadPathNetFx>
    <AcadPathNetFx Condition="'$(AcadPathNetFx)' == '' AND Exists('$(AcadPath2022)\acdbmgd.dll') AND (Exists('$(AcadPath2022)\C3D\AeccDbMgd.dll') OR Exists('$(AcadPath2022)\AeccDbMgd.dll'))">$(AcadPath2022)</AcadPathNetFx>
    <AcadPathNetFx Condition="'$(AcadPathNetFx)' == '' AND Exists('$(AcadPath2021)\acdbmgd.dll') AND (Exists('$(AcadPath2021)\C3D\AeccDbMgd.dll') OR Exists('$(AcadPath2021)\AeccDbMgd.dll'))">$(AcadPath2021)</AcadPathNetFx>
    <AcadPathNetFx Condition="'$(AcadPathNetFx)' == '' AND Exists('$(AcadPath2020)\acdbmgd.dll') AND (Exists('$(AcadPath2020)\C3D\AeccDbMgd.dll') OR Exists('$(AcadPath2020)\AeccDbMgd.dll'))">$(AcadPath2020)</AcadPathNetFx>
    <AcadPathNetFx Condition="'$(AcadPathNetFx)' == '' AND Exists('$(AcadPath2019)\acdbmgd.dll') AND (Exists('$(AcadPath2019)\C3D\AeccDbMgd.dll') OR Exists('$(AcadPath2019)\AeccDbMgd.dll'))">$(AcadPath2019)</AcadPathNetFx>
    <AcadPathNetFx Condition="'$(AcadPathNetFx)' == '' AND Exists('$(AcadPath2018)\acdbmgd.dll') AND (Exists('$(AcadPath2018)\C3D\AeccDbMgd.dll') OR Exists('$(AcadPath2018)\AeccDbMgd.dll'))">$(AcadPath2018)</AcadPathNetFx>
    <AcadPathNetFx Condition="'$(AcadPathNetFx)' == '' AND Exists('$(AcadPath2017)\acdbmgd.dll') AND (Exists('$(AcadPath2017)\C3D\AeccDbMgd.dll') OR Exists('$(AcadPath2017)\AeccDbMgd.dll'))">$(AcadPath2017)</AcadPathNetFx>
    <AcadPathNetFx Condition="'$(AcadPathNetFx)' == '' AND Exists('$(AcadPath2016)\acdbmgd.dll') AND (Exists('$(AcadPath2016)\C3D\AeccDbMgd.dll') OR Exists('$(AcadPath2016)\AeccDbMgd.dll'))">$(AcadPath2016)</AcadPathNetFx>
    <AcadPathNetFx Condition="'$(AcadPathNetFx)' == '' AND Exists('$(AcadPath2015)\acdbmgd.dll') AND (Exists('$(AcadPath2015)\C3D\AeccDbMgd.dll') OR Exists('$(AcadPath2015)\AeccDbMgd.dll'))">$(AcadPath2015)</AcadPathNetFx>
    <!-- Нет установленного Civil 3D 2015-2024 → референсные DLL из проекта -->
    <AcadPathNetFx Condition="'$(AcadPathNetFx)' == '' AND Exists('$(MSBuildProjectDirectory)\libs\acad-refs\net48\acdbmgd.dll')">$(MSBuildProjectDirectory)\libs\acad-refs\net48</AcadPathNetFx>

    <!-- Путь для ТЕКУЩЕГО собираемого таргета -->
    <AcadPathResolved Condition="'$(AcadPathResolved)' == '' AND '$(TargetFramework)' == 'net48'">$(AcadPathNetFx)</AcadPathResolved>
    <AcadPathResolved Condition="'$(AcadPathResolved)' == '' AND '$(TargetFramework)' == 'net8.0-windows'">$(AcadPathNet8)</AcadPathResolved>

    <!-- Civil 3D DLL: подпапка C3D (2021+), корень AutoCAD (2015-2020) или libs -->
    <C3DPathResolved Condition="'$(AcadPathResolved)' != '' AND Exists('$(AcadPathResolved)\C3D\AeccDbMgd.dll')">$(AcadPathResolved)\C3D</C3DPathResolved>
    <C3DPathResolved Condition="'$(C3DPathResolved)' == '' AND '$(AcadPathResolved)' != '' AND Exists('$(AcadPathResolved)\AeccDbMgd.dll')">$(AcadPathResolved)</C3DPathResolved>

    <!-- AEC base DLL: подпапка ACA (2026+), корень (ранние версии) или libs -->
    <AecBasePathResolved Condition="'$(AcadPathResolved)' != '' AND Exists('$(AcadPathResolved)\ACA\AecBaseMgd.dll')">$(AcadPathResolved)\ACA</AecBasePathResolved>
    <AecBasePathResolved Condition="'$(AecBasePathResolved)' == '' AND '$(AcadPathResolved)' != '' AND Exists('$(AcadPathResolved)\AecBaseMgd.dll')">$(AcadPathResolved)</AecBasePathResolved>

    <!-- Куда автодеплой кладёт DLL (внутри бандла) -->
    <BundleBase>$(APPDATA)\Autodesk\ApplicationPlugins\KartogrammaPlugin.bundle\Contents</BundleBase>
  </PropertyGroup>

  <!--
    Private=false: DLL не копируются в output — AutoCAD предоставит свои
    при загрузке плагина. API acdbmgd/acmgd/accoremgd/AecBaseMgd/AeccDbMgd
    стабилен внутри линейки, поэтому DLL, собранная по любой версии своей
    линейки, работает на всех остальных её версиях.
  -->
  <ItemGroup Condition="'$(AcadPathResolved)' != ''">
    <Reference Include="acdbmgd">
      <HintPath>$(AcadPathResolved)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AcadPathResolved)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AcadPathResolved)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Лента (Ribbon) AutoCAD -->
    <Reference Include="AdWindows">
      <HintPath>$(AcadPathResolved)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(C3DPathResolved)' != ''">
    <Reference Include="AeccDbMgd">
      <HintPath>$(C3DPathResolved)\AeccDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(AecBasePathResolved)' != ''">
    <Reference Include="AecBaseMgd">
      <HintPath>$(AecBasePathResolved)\AecBaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    ═══════════════════════════════════════════════════════════════
     АВТОДЕПЛОЙ В БАНДЛ после каждой сборки
     DLL автоматически копируется в нужную папку бандла.
     Civil 3D сам выбирает правильную DLL при запуске.
    ═══════════════════════════════════════════════════════════════
  -->
  <Target Name="DeployToBundle" AfterTargets="Build"
          Condition="'$(TargetFramework)' == 'net48' OR '$(TargetFramework)' == 'net8.0-windows'">

    <!-- Определяем подпапку по целевому фреймворку -->
    <PropertyGroup>
      <_BundleSubDir Condition="'$(TargetFramework)' == 'net8.0-windows'">net8</_BundleSubDir>
      <_BundleSubDir Condition="'$(TargetFramework)' == 'net48'">net48</_BundleSubDir>
      <_BundleDest>$(BundleBase)\$(_BundleSubDir)</_BundleDest>
    </PropertyGroup>

    <MakeDir Directories="$(_BundleDest)" Condition="!Exists('$(_BundleDest)')" />

    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(_BundleDest)"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true" />

    <!-- PackageContents.xml → корень бандла (Civil 3D ищет его там) -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\bundle\PackageContents.xml"
          DestinationFolder="$(BundleBase)\.."
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\bundle\PackageContents.xml')" />

    <Message Text="▶ Deployed $(TargetFramework) → $(_BundleDest)  [AutoCAD DLLs from: $(AcadPathResolved)]" Importance="High" />
  </Target>

</Project>
